{
  "extends": "@craudioviz/platform-sdk/config/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
